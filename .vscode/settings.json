{
  "sonarlint.connectedMode.project": {
    "connectionId": "pwurbs-oss",
    "projectKey": "wuflow-oss"
  },
  // Run golangci-lint on save so findings appear as live diagnostics in the
  // Problems panel, using the repo's .golangci.yml. The extension inspects the
  // binary's module version and selects the v2 CLI flag syntax automatically,
  // so no "-v2" tool alias is needed.
  "go.lintTool": "golangci-lint",
  // Extension default, pinned so a future default change cannot narrow it.
  "go.lintOnSave": "package"
}
