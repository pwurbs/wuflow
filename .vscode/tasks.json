{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "imageversion",
      "type": "promptString",
      "description": "Image-Version",
      "default": ""
    },
    {
      "id": "fuzzduration",
      "type": "promptString",
      "description": "Fuzz time per target (e.g. 30s, 2m)",
      "default": "30s"
    }
  ],
  "tasks": [
    {
      // for both standalone execution and precondition for sonar-scanner
      "label": "Go Test",
      "type": "shell",
      "command": "go test -v -coverprofile=backend/test-results/coverage.out ./backend/...",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      // for both standalone execution and precondition for sonar-scanner
      "label": "Go Checks",
      "type": "shell",
      "command": "./scripts/go_checks.sh",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Go Race & Fuzz",
      "type": "shell",
      "command": "./scripts/go_race_fuzz.sh ${input:fuzzduration}",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      // for both standalone execution and precondition for sonar-scanner
      "label": "JS Test",
      "type": "shell",
      "command": "npm run test:coverage",
      "options": {
        "cwd": "${workspaceFolder}/static/js"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Diff Coverage",
      "type": "shell",
      "command": "./scripts/diff_coverage.sh",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Playwright Tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/playwright"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Sonar",
      "type": "shell",
      // results also after a failed scan or quality gate; the task keeps the scan's exit code
      "command": "./scripts/sonar_scan.sh; rc=$?; ./scripts/sonar_results.sh; exit $rc",
      "dependsOn": ["Go Test", "JS Test", "Go Checks"],
      "dependsOrder": "sequence",
      "options": {
        "shell": {
          "args": [
            "-l",
            "-i",
            "-c"
          ]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Wapiti",
      "type": "shell",
      "command": "./scripts/run_wapiti_scan.sh",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Dependency Check",
      "type": "shell",
      "command": "./scripts/check_dependencies.sh",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build & Scan Image",
      "type": "shell",
      "command": "export VERSION=$(cat VERSION) && container build --no-cache --arch arm64 --build-arg VERSION=$VERSION -t wuflow:$VERSION . && sh scripts/trivy_scan.sh",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Image Release",
      "type": "shell",
      "command": "bash ./scripts/image_release.sh",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run locally",
      "type": "shell",
      "command": "(cd static/js && npm run build) && mkdir -p local-databases && go run -ldflags=\"-w -s -X main.Version=$(cat VERSION)\" . -secret-key 12345 -dbpath ./local-databases/wuflow-test.db 2>&1 | tee local-databases/wuflow-local.log",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "New Version",
      "type": "shell",
      "command": "./scripts/new_version.sh",
      "problemMatcher": []
    },
    {
      "label": "Helm Release",
      "type": "shell",
      "command": "bash ./scripts/helm_release.sh",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}