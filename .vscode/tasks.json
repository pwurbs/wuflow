{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "imageversion",
      "type": "promptString",
      "description": "Image-Version",
      "default": ""
    },
    {
      "id": "fuzzduration",
      "type": "promptString",
      "description": "Fuzz time per target (e.g. 30s, 2m)",
      "default": "30s"
    }
  ],
  "tasks": [
    {
      // for both standalone execution and precondition for sonar-scanner
      "label": "Go Test",
      "type": "shell",
      "command": "go test -v -coverprofile=backend/test-results/coverage.out ./backend/...",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      // for both standalone execution and precondition for sonar-scanner
      "label": "Go Checks",
      "type": "shell",
      "command": "./scripts/go_checks.sh",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Go Fuzz",
      "type": "shell",
      "command": "for t in FuzzValidateLabel FuzzValidateUser FuzzIsBlacklistedPassword FuzzValidateIssue FuzzValidateProject FuzzValidateStatusConfig FuzzValidateRelease; do echo \"--- $t ---\" && go test -run='^$' -fuzz=$t -fuzztime=${input:fuzzduration} ./backend/ || break; done",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      // for both standalone execution and precondition for sonar-scanner
      "label": "JS Test",
      "type": "shell",
      "command": "npm run test:coverage",
      "options": {
        "cwd": "${workspaceFolder}/static/js"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Diff Coverage",
      "type": "shell",
      "command": "./scripts/diff_coverage.sh",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Playwright Tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/playwright"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Sonar Scanner",
      "type": "shell",
      "command": "export VERSION=$(cat VERSION) && export BRANCH=$(git branch --show-current) && sonar-scanner -Dsonar.token=${env:SONAR_TOKEN} -Dsonar.projectVersion=$VERSION -Dsonar.branch.name=$BRANCH",
      "dependsOn": ["Go Test", "JS Test", "Go Checks"],
      "dependsOrder": "sequence",
      "options": {
        "shell": {
          "args": [
            "-l",
            "-i",
            "-c"
          ]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Wapiti",
      "type": "shell",
      "command": "./scripts/run_wapiti_scan.sh",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Dependency Check",
      "type": "shell",
      "command": "./scripts/check_dependencies.sh",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build & Scan Image",
      "type": "shell",
      "command": "export VERSION=$(cat VERSION) && container build --no-cache --arch arm64 --build-arg VERSION=$VERSION -t wuflow:$VERSION . && sh scripts/trivy_scan.sh",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build & Push Image",
      "type": "shell",
      "command": "export VERSION=$(cat VERSION) && echo $GHCR_TOKEN | container registry login ghcr.io -u pwurbs --password-stdin && container build --no-cache --arch amd64,arm64 --build-arg VERSION=$VERSION -t ghcr.io/pwurbs/wuflow:$VERSION . && container image push ghcr.io/pwurbs/wuflow:$VERSION",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run locally",
      "type": "shell",
      "command": "go run -ldflags=\"-w -s -X main.Version=$(cat VERSION)\" . -secret-key 12345 -dbpath ./wuflow-test.db",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "New Version",
      "type": "shell",
      "command": "./scripts/new_version.sh",
      "problemMatcher": []
    },
    {
      "label": "Deploy dev",
      "type": "shell",
      "command": "bash ./deploy/helm_deploy.sh dev",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}