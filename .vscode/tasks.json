{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "imageversion",
      "type": "promptString",
      "description": "Image-Version",
      "default": ""
    },
    {
      "id": "fuzzduration",
      "type": "promptString",
      "description": "Fuzz time per target (e.g. 30s, 2m)",
      "default": "30s"
    }
  ],
  "tasks": [
    {
      "label": "Go Test",
      "type": "shell",
      "command": "go test -v -coverprofile=coverage.out ./backend/...",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Go Fuzz",
      "type": "shell",
      // Runs each fuzz target sequentially for the chosen duration.
      // Stops immediately if a target finds a failure (|| break).
      // To only run the seed corpus without fuzzing, use "Go Fuzz Seed Check".
      "command": "for t in FuzzSanitizeHTML FuzzValidateLabel FuzzValidateUser FuzzIsBlacklistedPassword FuzzValidateIssue; do echo \"--- $t ---\" && go test -run='^$' -fuzz=$t -fuzztime=${input:fuzzduration} ./backend/ || break; done",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "JS Test",
      "type": "shell",
      "command": "npm run test:coverage",
      "options": {
        "cwd": "${workspaceFolder}/static/js"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Go Build",
      "type": "shell",
      "command": "go build -v -ldflags \"-X main.Version=$(cat VERSION)\" -o bin/wuflow main.go",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Run Playwright Tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/playwright"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Sonar Scanner",
      "type": "shell",
      // SONAR_TOKEN is a secret token that needs to be set in the environment
      // projectVersion must be set to get correct "new code" related results in SonarQube
      "command": "export VERSION=$(cat VERSION) && sonar-scanner -Dsonar.token=${env:SONAR_TOKEN} -Dsonar.projectVersion=$VERSION",
      // Use a login interactive shell to ensure the user's PATH and SONAR_TOKEN are loaded correctly (finding sonar-scanner binary)
      "options": {
        "shell": {
          "args": [
            "-l",
            "-i",
            "-c"
          ]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Full Pipeline",
      "dependsOn": [
        "Go Test",
        "Go Fuzz",
        "JS Test",
        "Go Build",
        "Run Playwright Tests",
        "Sonar Scanner"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      // Builds the container image (latest tag) and tags it with the given version
      // Uses --no-cache to ensure latest static files are embedded
      "label": "Build Image",
      "type": "shell",
      "command": "export VERSION=$(cat VERSION) && container build --no-cache --build-arg VERSION=$VERSION -t wuflow . && container image tag wuflow:latest wuflow:$VERSION",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      // Logs in to registry, tags and pushes the container image to ghcr.io
      // Note: GHCR_TOKEN is a secret token that needs to be set in the environment
      "label": "Push Image",
      "type": "shell",
      "command": "export VERSION=$(cat VERSION) && echo $GHCR_TOKEN | container registry login ghcr.io -u pwurbs --password-stdin && container image tag wuflow:$VERSION ghcr.io/pwurbs/wuflow:$VERSION && container image push ghcr.io/pwurbs/wuflow:$VERSION",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Container",
      "type": "shell",
      "command": "export VERSION=$(cat VERSION) && container rm -f wuflow || true && container run -d -p 8080:8080 --name wuflow wuflow:$VERSION",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Stop Container",
      "type": "shell",
      "command": "container stop wuflow || true",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}