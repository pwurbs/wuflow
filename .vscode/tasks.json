{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "imageversion",
      "type": "promptString",
      "description": "Image-Version",
      "default": ""
    }
  ],
  "tasks": [
    {
      "label": "Go Test",
      "type": "shell",
      "command": "go test -v -coverprofile=coverage.out ./backend/...",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "JS Test",
      "type": "shell",
      "command": "npm run test:coverage",
      "options": {
        "cwd": "${workspaceFolder}/static/js"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Go Build",
      "type": "shell",
      "command": "go build -v -o bin/wuflow main.go",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Run Playwright Tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/playwright"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Sonar Scanner",
      "type": "shell",
      "command": "sonar-scanner",
      // Use a login interactive shell to ensure the user's PATH and SONAR_TOKEN are loaded correctly (finding sonar-scanner binary)
      "options": {
        "shell": {
          "args": [
            "-l",
            "-i",
            "-c"
          ]
        }
      },
      // Note: SONAR_TOKEN is a secret token that needs to be set in the environment
      "args": [
        "-Dsonar.token=${env:SONAR_TOKEN}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Full Pipeline",
      "dependsOn": [
        "Go Test",
        "JS Test",
        "Go Build",
        "Run Playwright Tests",
        "Sonar Scanner"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      // Builds the container image (latest tag) and tags it with the given version
      "label": "Build Image",
      "type": "shell",
      "command": "container build -t wuflow . && container image tag wuflow:latest wuflow:${input:imageversion}",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      // Logs in to registry, tags and pushes the container image to ghcr.io
      // Note: GHCR_TOKEN is a secret token that needs to be set in the environment
      "label": "Push Image",
      "type": "shell",
      "command": "echo $GHCR_TOKEN | container registry login ghcr.io -u pwurbs --password-stdin && container image tag wuflow:${input:imageversion} ghcr.io/pwurbs/wuflow:${input:imageversion} && container image push ghcr.io/pwurbs/wuflow:${input:imageversion}",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Container",
      "type": "shell",
      "command": "container rm -f wuflow || true && container run -d -p 8080:8080 --name wuflow wuflow:latest",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Stop Container",
      "type": "shell",
      "command": "container stop wuflow || true",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}