    "/projects/{id}/issues/active": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Get active issues for a project (Todo, Pending, Working, Done)",
        "tags": [
          "Issues"
        ],
        "responses": {
          "200": {
            "description": "List of active issues for the project (excludes Open and Archive statuses)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
