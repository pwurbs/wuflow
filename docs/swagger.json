{
  "openapi": "3.0.0",
  "info": {
    "title": "wuFlow API",
    "version": "1.0.0",
    "description": "API documentation for the wuFlow application."
  },
  "servers": [
    {
      "url": "/api",
      "description": "Base URL"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wf_access_token"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Issue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "Todo",
              "Stage1",
              "Stage2",
              "Stage3",
              "Stage4",
              "Done",
              "Archive"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "Normal",
              "High"
            ]
          },
          "label_id": {
            "type": "integer"
          },
          "project_id": {
            "type": "integer",
            "description": "ID of the project this issue belongs to. Defaults to 1 (default project) if not set."
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "issue_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      },
      "Label": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "maxLength": 15
          },
          "color": {
            "type": "string",
            "description": "Hex color code, e.g. #ff0000"
          },
          "project_id": {
            "type": "integer",
            "description": "ID of the project this label belongs to"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UserCreateRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin",
              "sysadmin"
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "Optional. Leave empty to keep current password."
          },
          "admin_password": {
            "type": "string",
            "description": "Required when 'password' is provided or the role is being promoted (user→admin, user→sysadmin, admin→sysadmin). The requesting sysadmin's own current password for confirmation."
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin",
              "sysadmin"
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "SelfUpdateRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "New password."
          },
          "current_password": {
            "type": "string",
            "description": "Required when 'password' is provided. The user's current password for confirmation."
          }
        }
      },
      "IssueCreateRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "Todo",
              "Stage1",
              "Stage2",
              "Stage3",
              "Stage4",
              "Done",
              "Archive"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "Normal",
              "High"
            ]
          },
          "label_id": {
            "type": "integer"
          },
          "project_id": {
            "type": "integer",
            "description": "Optional. Defaults to 1 (default project) if omitted."
          }
        },
        "required": [
          "title",
          "status",
          "priority"
        ]
      },
      "IssueUpdateRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "Todo",
              "Stage1",
              "Stage2",
              "Stage3",
              "Stage4",
              "Done"
            ]
          }
        }
      },
      "StatusConfig": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "stage1_name": {
            "type": "string",
            "maxLength": 15,
            "description": "Display name for Stage1 column. Default: 'Pending'. Empty = hidden."
          },
          "stage2_name": {
            "type": "string",
            "maxLength": 15,
            "description": "Display name for Stage2 column. Default: 'Working'. Empty = hidden."
          },
          "stage3_name": {
            "type": "string",
            "maxLength": 15,
            "description": "Display name for Stage3 column. Default: '' (hidden)."
          },
          "stage4_name": {
            "type": "string",
            "maxLength": 15,
            "description": "Display name for Stage4 column. Default: '' (hidden)."
          }
        }
      },
      "StatusConfigUpdateRequest": {
        "type": "object",
        "properties": {
          "stage1_name": {
            "type": "string",
            "maxLength": 15
          },
          "stage2_name": {
            "type": "string",
            "maxLength": 15
          },
          "stage3_name": {
            "type": "string",
            "maxLength": 15
          },
          "stage4_name": {
            "type": "string",
            "maxLength": 15
          }
        }
      },
      "TaskCreateRequest": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "issue_id",
          "title"
        ]
      },
      "TaskUpdateRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      },
      "LabelCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "color"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "maxLength": 15
          },
          "description": {
            "type": "string",
            "maxLength": 100
          }
        }
      },
      "ProjectCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 15
          },
          "description": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "ProjectUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 15
          },
          "description": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "Release": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "project_id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "maxLength": 20
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": ["open", "closed"]
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "release_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "closed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "owner_id": {
            "type": "integer",
            "nullable": true,
            "description": "ID of the user responsible for this release"
          },
          "owner": {
            "$ref": "#/components/schemas/User",
            "nullable": true,
            "description": "Embedded owner user object, present when owner_id is set"
          }
        }
      },
      "ReleaseWriteRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20,
            "description": "Required"
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "description": "Optional plain-text summary"
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Optional. Year must be 2000–2100."
          },
          "release_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Optional. Must not be before start_date. Year must be 2000–2100."
          },
          "owner_id": {
            "type": "integer",
            "nullable": true,
            "description": "Optional. ID of the user responsible for this release."
          }
        },
        "required": ["name"]
      }
    }
  },
  "security": [
    {
      "cookieAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate user",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Clear auth cookies",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Token refreshed"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get current user",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Current user details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "put": {
        "summary": "Change own password",
        "description": "Allows the authenticated user to change their own password. Requires the current password for confirmation. All sessions are revoked on success.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelfUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - password policy violation or current_password missing/incorrect"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "List all users",
        "tags": [
          "Users"
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      },
      "post": {
        "summary": "Create new user",
        "description": "Requires sysadmin role.",
        "x-required-role": "sysadmin",
        "tags": [
          "Users"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/users/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Get user details",
        "tags": [
          "Users"
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "summary": "Update user",
        "description": "Requires sysadmin role.",
        "x-required-role": "sysadmin",
        "tags": [
          "Users"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/issues": {
      "post": {
        "summary": "Create a new issue",
        "tags": [
          "Issues"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created issue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            }
          }
        }
      }
    },
    "/issues/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Get issue details",
        "tags": [
          "Issues"
        ],
        "responses": {
          "200": {
            "description": "Issue details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update issue",
        "tags": [
          "Issues"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated issue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      },
      "delete": {
        "summary": "Delete issue",
        "description": "Requires admin or sysadmin role.",
        "x-required-role": "admin",
        "tags": [
          "Issues"
        ],
        "responses": {
          "204": {
            "description": "Issue deleted"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/issues/{id}/archive": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "post": {
        "summary": "Archive an issue",
        "description": "Requires admin or sysadmin role.",
        "x-required-role": "admin",
        "tags": [
          "Issues"
        ],
        "responses": {
          "200": {
            "description": "Archived issue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/issues/{id}/unarchive": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "post": {
        "summary": "Unarchive an issue",
        "description": "Requires admin or sysadmin role.",
        "x-required-role": "admin",
        "tags": [
          "Issues"
        ],
        "responses": {
          "200": {
            "description": "Unarchived issue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/tasks": {
      "post": {
        "summary": "Create task",
        "tags": [
          "Tasks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "put": {
        "summary": "Update task",
        "tags": [
          "Tasks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete task",
        "tags": [
          "Tasks"
        ],
        "responses": {
          "204": {
            "description": "Task deleted"
          }
        }
      }
    },
    "/projects/{id}/labels": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Project ID",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "List labels for a project",
        "tags": [
          "Labels"
        ],
        "responses": {
          "200": {
            "description": "List of labels for the project",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Label"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Project not found"
          }
        }
      },
      "post": {
        "summary": "Create label for a project",
        "description": "Requires admin or sysadmin role.",
        "x-required-role": "admin",
        "tags": [
          "Labels"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabelCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created label",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Label"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Project not found"
